diff --git a/backend/tests/helpers/fakeModels.js b/backend/tests/helpers/fakeModels.js
new file mode 100644
index 0000000..92f602f
--- /dev/null
+++ b/backend/tests/helpers/fakeModels.js
@@ -0,0 +1,145 @@
+// A tiny in-memory stand-in for the Mongoose models, so the real Express app, middleware and
+// controllers can be tested without a MongoDB server. It supports exactly the calls the code makes.
+const path = require('path');
+const mongoose = require('mongoose');
+const bcrypt = require('bcryptjs');
+
+const getPath = (obj, key) => key.split('.').reduce((o, k) => (o == null ? undefined : o[k]), obj);
+
+const matches = (doc, query) =>
+    Object.entries(query).every(([key, cond]) => {
+        const value = getPath(doc, key);
+        if (value === undefined) return false;
+        if (cond && typeof cond === 'object' && Array.isArray(cond.$in)) {
+            return cond.$in.some((candidate) => String(candidate) === String(value));
+        }
+        return String(value) === String(cond);
+    });
+
+const applyUpdate = (doc, update) => {
+    const hasOperators = Object.keys(update).some((key) => key.startsWith('$'));
+    if (!hasOperators) {
+        Object.assign(doc, update);
+        return;
+    }
+    Object.assign(doc, update.$set || {});
+    Object.keys(update.$unset || {}).forEach((key) => delete doc[key]);
+    Object.entries(update.$inc || {}).forEach(([key, amount]) => {
+        doc[key] = (doc[key] || 0) + amount;
+    });
+};
+
+const createFakeModel = ({ hashPassword = false, unique = [], defaults = {} } = {}) => {
+    const store = [];
+
+    class Doc {
+        constructor(data = {}) {
+            Object.assign(this, defaults, data);
+            if (!this._id) this._id = new mongoose.Types.ObjectId();
+        }
+
+        toObject() {
+            return { ...this };
+        }
+
+        async save() {
+            for (const field of unique) {
+                const value = this[field];
+                const clash = store.find((other) => other !== this && value !== undefined && other[field] === value);
+                if (clash) {
+                    const error = new Error(`E11000 duplicate key: ${field}`);
+                    error.code = 11000;
+                    throw error;
+                }
+            }
+            // Same behaviour as the real pre-save hook: hash a newly set password once.
+            if (hashPassword && this.password && !String(this.password).startsWith('$2')) {
+                this.password = await bcrypt.hash(this.password, 4);
+            }
+            if (!store.includes(this)) store.push(this);
+            return this;
+        }
+
+        static async findOne(query) {
+            return store.find((doc) => matches(doc, query)) || null;
+        }
+
+        static async findById(id) {
+            return store.find((doc) => String(doc._id) === String(id)) || null;
+        }
+
+        static async find(query = {}) {
+            return store.filter((doc) => matches(doc, query));
+        }
+
+        static async findOneAndDelete(query) {
+            const doc = store.find((d) => matches(d, query));
+            if (doc) store.splice(store.indexOf(doc), 1);
+            return doc || null;
+        }
+
+        static async findOneAndUpdate(query, update) {
+            const doc = store.find((d) => matches(d, query));
+            if (!doc) return null;
+            applyUpdate(doc, update);
+            return doc;
+        }
+
+        static async findByIdAndUpdate(id, update) {
+            const doc = store.find((d) => String(d._id) === String(id));
+            if (!doc) return null;
+            applyUpdate(doc, update);
+            return doc;
+        }
+
+        static async updateOne(query, update) {
+            const doc = store.find((d) => matches(d, query));
+            if (doc) applyUpdate(doc, update);
+            return { modifiedCount: doc ? 1 : 0 };
+        }
+
+        static async updateMany(query, update) {
+            const docs = store.filter((d) => matches(d, query));
+            docs.forEach((doc) => applyUpdate(doc, update));
+            return { modifiedCount: docs.length };
+        }
+
+        static async deleteOne(query) {
+            const doc = store.find((d) => matches(d, query));
+            if (doc) store.splice(store.indexOf(doc), 1);
+            return { deletedCount: doc ? 1 : 0 };
+        }
+    }
+
+    Doc.store = store;
+    Doc.reset = () => { store.length = 0; };
+    return Doc;
+};
+
+const models = {
+    user: createFakeModel({ hashPassword: true, unique: ['email'] }),
+    admin: createFakeModel({ hashPassword: true, unique: ['email'] }),
+    cart: createFakeModel({ defaults: { status: 'Pending' } }),
+    food: createFakeModel({ unique: ['name'] }),
+    payment: createFakeModel({ unique: ['reference'], defaults: { status: 'Paid' } }),
+};
+
+const files = {
+    user: '../../model/userModel',
+    admin: '../../model/adminModel',
+    cart: '../../model/cartModel',
+    food: '../../model/adminUploadFoodModel',
+    payment: '../../model/PaymentModel',
+};
+
+// Must run before anything requires the real models.
+const install = () => {
+    Object.entries(files).forEach(([name, relative]) => {
+        const resolved = require.resolve(path.join(__dirname, relative));
+        require.cache[resolved] = { id: resolved, filename: resolved, loaded: true, exports: models[name], children: [], paths: [] };
+    });
+};
+
+const resetAll = () => Object.values(models).forEach((model) => model.reset());
+
+module.exports = { models, install, resetAll };
diff --git a/backend/tests/helpers/harness.js b/backend/tests/helpers/harness.js
new file mode 100644
index 0000000..23f4425
--- /dev/null
+++ b/backend/tests/helpers/harness.js
@@ -0,0 +1,114 @@
+// Boots the real Express app on a random port with fakes for the database, Paystack and email.
+const path = require('path');
+const nodemailer = require('nodemailer');
+
+process.env.SECRET = 'unit-test-secret';
+process.env.PAYSTACK_SECRET_KEY = 'sk_test_unit';
+process.env.NODE_ENV = 'test';
+
+const realFetch = global.fetch;
+
+// ---- Paystack stub (only api.paystack.co calls are intercepted) ----
+const paystack = { calls: [], respond: null, networkError: false };
+
+global.fetch = async (url, options) => {
+    if (String(url).startsWith('https://api.paystack.co/')) {
+        paystack.calls.push({ url: String(url), options });
+        if (paystack.networkError) throw new Error('network down');
+        return paystack.respond(String(url));
+    }
+    return realFetch(url, options);
+};
+
+const reply = (body, status = 200) => ({ ok: status >= 200 && status < 300, status, json: async () => body });
+
+paystack.succeed = (amountKobo, extra = {}) => {
+    paystack.respond = () => reply({
+        status: true,
+        data: { status: 'success', amount: amountKobo, currency: 'NGN', id: 4242, ...extra },
+    });
+};
+paystack.fail = (txStatus = 'abandoned') => {
+    paystack.respond = () => reply({ status: true, data: { status: txStatus, amount: 0, currency: 'NGN' } });
+};
+paystack.reset = () => {
+    paystack.calls = [];
+    paystack.networkError = false;
+    paystack.fail();
+};
+
+// ---- Email stub: captures the message instead of sending it ----
+const sentMail = [];
+nodemailer.createTransport = () => ({
+    sendMail: async (message) => { sentMail.push(message); return { messageId: 'test' }; },
+});
+
+const latestOtpFor = (email) => {
+    const message = [...sentMail].reverse().find((m) => m.to === email);
+    if (!message) return null;
+    const match = message.html.match(/class="otp">(\d{6})</);
+    return match ? match[1] : null;
+};
+
+// ---- Database fakes ----
+const fake = require('./fakeModels');
+fake.install();
+
+// Rate limiting has its own test file; here it is switched off so repeated logins do not trip it.
+const limiterPath = require.resolve(path.join(__dirname, '../../middleware/rateLimiters'));
+const passThrough = (req, res, next) => next();
+require.cache[limiterPath] = {
+    id: limiterPath, filename: limiterPath, loaded: true, children: [], paths: [],
+    exports: { apiLimiter: passThrough, authLimiter: passThrough, otpLimiter: passThrough },
+};
+
+const app = require('../../app');
+
+const start = () => new Promise((resolve) => {
+    const server = app.listen(0, '127.0.0.1', () => {
+        const base = `http://127.0.0.1:${server.address().port}`;
+
+        const call = async (method, route, { token, body, headers } = {}) => {
+            const response = await realFetch(`${base}/api/v1${route}`, {
+                method,
+                headers: {
+                    'content-type': 'application/json',
+                    ...(token ? { authorization: `Bearer ${token}` } : {}),
+                    ...(headers || {}),
+                },
+                body: body === undefined ? undefined : JSON.stringify(body),
+            });
+            let json = null;
+            try { json = await response.json(); } catch (error) { json = null; }
+            return { status: response.status, body: json, headers: response.headers };
+        };
+
+        const raw = (route, options) => realFetch(`${base}${route}`, options);
+
+        resolve({ server, call, raw, close: () => new Promise((done) => server.close(done)) });
+    });
+});
+
+// ---- Helpers for building scenarios ----
+const signupAndLogin = async (call, { email, password = 'secret123', firstname = 'Ada', lastname = 'Obi' }) => {
+    await call('POST', '/userSignup', { body: { firstname, lastname, email, password, phonenumber: '08012345678' } });
+    const login = await call('POST', '/userLogin', { body: { email, password } });
+    return { token: login.body.token, user: login.body.user, password };
+};
+
+const adminLoginToken = async (call, email = 'boss@bitemore.test') => {
+    process.env.ADMIN_SIGNUP_CODE = 'let-me-in';
+    await call('POST', '/adminSignup', {
+        body: { firstname: 'Boss', lastname: 'Admin', email, password: 'adminpass1', phonenumber: '08000000000', adminToken: 'let-me-in' },
+    });
+    const login = await call('POST', '/adminLogin', { body: { email, password: 'adminpass1' } });
+    return login.body.token;
+};
+
+const addFood = async (name, price) => {
+    const food = new fake.models.food({ name, price, description: `${name} description`, profileImage: `https://img.test/${name}.jpg` });
+    await food.save();
+    return food;
+};
+
+module.exports = { start, fake, paystack, sentMail, latestOtpFor, signupAndLogin, adminLoginToken, addFood };
diff --git a/backend/tests/ratelimit.test.js b/backend/tests/ratelimit.test.js
new file mode 100644
index 0000000..22d0f87
--- /dev/null
+++ b/backend/tests/ratelimit.test.js
@@ -0,0 +1,71 @@
+// Uses the REAL rate limiters (the other test files switch them off), so it runs in its own process.
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+
+process.env.SECRET = 'unit-test-secret';
+process.env.NODE_ENV = 'test';
+
+const fake = require('./helpers/fakeModels');
+fake.install();
+const app = require('../app');
+
+let server;
+let base;
+before(() => new Promise((resolve) => {
+    server = app.listen(0, '127.0.0.1', () => {
+        base = `http://127.0.0.1:${server.address().port}/api/v1`;
+        resolve();
+    });
+}));
+after(() => new Promise((resolve) => server.close(resolve)));
+
+const post = (route, ip, body = { email: 'nobody@test.com', password: 'x', otp: '123456' }) =>
+    fetch(base + route, {
+        method: 'POST',
+        headers: { 'content-type': 'application/json', 'x-forwarded-for': ip },
+        body: JSON.stringify(body),
+    });
+
+test('login is limited to 20 attempts per client, then answers 429 with a JSON message', async () => {
+    const ip = '10.0.0.1';
+    for (let i = 1; i <= 20; i++) {
+        const res = await post('/userLogin', ip);
+        assert.equal(res.status, 404, `attempt ${i} should reach the handler`);
+    }
+    const blocked = await post('/userLogin', ip);
+    assert.equal(blocked.status, 429);
+    const body = await blocked.json();
+    assert.equal(body.status, false);
+    assert.match(body.message, /too many/i);
+    assert.ok(blocked.headers.get('ratelimit') || blocked.headers.get('ratelimit-policy'), 'standard rate limit headers are sent');
+});
+
+test('the limit is per client address (behind the proxy), so one noisy visitor does not block everyone', async () => {
+    const res = await post('/userLogin', '10.0.0.2');
+    assert.equal(res.status, 404, 'a different client is unaffected by 10.0.0.1 being blocked');
+});
+
+test('reset-code endpoints have their own stricter limit of 10', async () => {
+    const ip = '10.0.0.3';
+    for (let i = 1; i <= 10; i++) {
+        const res = await post('/userVerifyOTP', ip);
+        assert.equal(res.status, 404, `attempt ${i} should reach the handler`);
+    }
+    assert.equal((await post('/userVerifyOTP', ip)).status, 429);
+    assert.equal((await post('/userForgotPin', ip)).status, 429, 'all reset endpoints share the one budget');
+    assert.equal((await post('/userLogin', ip)).status, 404, 'login has its own separate budget');
+});
+
+test('admin login and signup are limited too', async () => {
+    const ip = '10.0.0.4';
+    for (let i = 1; i <= 20; i++) await post('/adminLogin', ip);
+    assert.equal((await post('/adminLogin', ip)).status, 429);
+    assert.equal((await post('/adminSignup', ip)).status, 429, 'signup shares the auth budget');
+});
+
+test('the health check is never rate limited', async () => {
+    for (let i = 0; i < 50; i++) {
+        const res = await fetch(base.replace('/api/v1', '/health'), { headers: { 'x-forwarded-for': '10.0.0.5' } });
+        assert.equal(res.status, 200);
+    }
+});
diff --git a/backend/tests/reset.test.js b/backend/tests/reset.test.js
new file mode 100644
index 0000000..3658fdb
--- /dev/null
+++ b/backend/tests/reset.test.js
@@ -0,0 +1,179 @@
+const { test, before, after, beforeEach } = require('node:test');
+const assert = require('node:assert/strict');
+const h = require('./helpers/harness');
+
+let api;
+before(async () => { api = await h.start(); });
+after(async () => { await api.close(); });
+beforeEach(() => { h.fake.resetAll(); h.paystack.reset(); h.sentMail.length = 0; });
+
+const { models } = h.fake;
+const userDoc = (email) => models.user.store.find((u) => u.email === email);
+const loginWorks = async (email, password) => (await api.call('POST', '/userLogin', { body: { email, password } })).body.status === true;
+
+const request = (email) => api.call('POST', '/userResetpassword', { body: { email } });
+const verify = (email, otp) => api.call('POST', '/userVerifyOTP', { body: { email, otp } });
+const reset = (body) => api.call('POST', '/userForgotPin', { body });
+
+test('the original hole is closed: resetting with just an email and a new password does nothing', async () => {
+    await h.signupAndLogin(api.call, { email: 'victim@test.com', password: 'victimpass' });
+
+    for (const route of ['/userForgotPin', '/forgotPin']) {
+        const res = await api.call('POST', route, { body: { email: 'victim@test.com', newPassword: 'attacker99' } });
+        assert.equal(res.status, 400, `${route} must require a code`);
+    }
+    assert.equal(await loginWorks('victim@test.com', 'victimpass'), true);
+    assert.equal(await loginWorks('victim@test.com', 'attacker99'), false);
+});
+
+test('requesting a code emails a 6-digit number and stores only a hash of it', async () => {
+    await h.signupAndLogin(api.call, { email: 'a@test.com' });
+    const res = await request('a@test.com');
+    assert.equal(res.status, 200);
+
+    const otp = h.latestOtpFor('a@test.com');
+    assert.match(otp, /^\d{6}$/);
+    assert.match(h.sentMail[0].html, /10 minutes/);
+
+    const doc = userDoc('a@test.com');
+    assert.ok(doc.otpHash, 'a hash is stored');
+    assert.equal(doc.otpHash.includes(otp), false, 'the code itself is not stored');
+    assert.equal('otp' in doc, false, 'no plaintext otp field');
+    const ttl = doc.otpExpires.getTime() - Date.now();
+    assert.ok(ttl > 9 * 60 * 1000 && ttl <= 10 * 60 * 1000, `expires in about 10 minutes, got ${ttl}ms`);
+});
+
+test('codes look random: 200 requests give 6 digits each with no obvious repeats', async () => {
+    await h.signupAndLogin(api.call, { email: 'a@test.com' });
+    const seen = new Set();
+    for (let i = 0; i < 200; i++) {
+        // Skip the 1-minute resend cooldown by backdating the previous code.
+        userDoc('a@test.com').otpExpires = new Date(Date.now() - 1);
+        await request('a@test.com');
+        const otp = h.latestOtpFor('a@test.com');
+        assert.match(otp, /^[1-9]\d{5}$/);
+        seen.add(otp);
+    }
+    assert.ok(seen.size > 190, `expected mostly unique codes, got ${seen.size}/200`);
+});
+
+test('unknown email and missing email are handled', async () => {
+    assert.equal((await request('nobody@test.com')).status, 404);
+    assert.equal((await api.call('POST', '/userResetpassword', { body: {} })).status, 400);
+    assert.equal((await api.call('POST', '/userResetpassword', { body: { email: { $ne: null } } })).status, 400);
+    assert.equal(h.sentMail.length, 0);
+});
+
+test('requesting codes in a loop is throttled per account', async () => {
+    await h.signupAndLogin(api.call, { email: 'a@test.com' });
+    assert.equal((await request('a@test.com')).status, 200);
+    const second = await request('a@test.com');
+    assert.equal(second.status, 429);
+    assert.equal(h.sentMail.length, 1, 'no second email is sent');
+});
+
+test('full happy path: request, verify, reset, then the new password works and the code is spent', async () => {
+    await h.signupAndLogin(api.call, { email: 'a@test.com', password: 'oldpass123' });
+    await request('a@test.com');
+    const otp = h.latestOtpFor('a@test.com');
+
+    const checked = await verify('a@test.com', otp);
+    assert.equal(checked.status, 200);
+    assert.equal(checked.body.status, true);
+    assert.ok(userDoc('a@test.com').otpHash, 'verifying alone does not use the code up');
+
+    const done = await reset({ email: 'a@test.com', otp, newPassword: 'brandnew456' });
+    assert.equal(done.status, 200);
+    assert.equal(await loginWorks('a@test.com', 'brandnew456'), true);
+    assert.equal(await loginWorks('a@test.com', 'oldpass123'), false);
+    assert.equal(userDoc('a@test.com').otpHash, undefined);
+
+    const replay = await reset({ email: 'a@test.com', otp, newPassword: 'again789' });
+    assert.equal(replay.status, 400, 'the same code cannot be used twice');
+    assert.equal(await loginWorks('a@test.com', 'brandnew456'), true);
+});
+
+test('a wrong code is refused and leaves the password alone', async () => {
+    await h.signupAndLogin(api.call, { email: 'a@test.com', password: 'oldpass123' });
+    await request('a@test.com');
+    const otp = h.latestOtpFor('a@test.com');
+    const wrong = otp === '123456' ? '654321' : '123456';
+
+    assert.equal((await verify('a@test.com', wrong)).status, 401);
+    assert.equal((await reset({ email: 'a@test.com', otp: wrong, newPassword: 'attacker99' })).status, 401);
+    for (const bad of ['', 'abcdef', '12345', '1234567', null, { $ne: null }]) {
+        const res = await reset({ email: 'a@test.com', otp: bad, newPassword: 'attacker99' });
+        assert.ok(res.status === 400 || res.status === 401, `otp ${JSON.stringify(bad)} gave ${res.status}`);
+    }
+    assert.equal(await loginWorks('a@test.com', 'oldpass123'), true);
+});
+
+test('after 5 wrong guesses the code is thrown away, even the right one stops working', async () => {
+    await h.signupAndLogin(api.call, { email: 'a@test.com', password: 'oldpass123' });
+    await request('a@test.com');
+    const otp = h.latestOtpFor('a@test.com');
+    const wrong = otp === '111111' ? '222222' : '111111';
+
+    for (let i = 0; i < 5; i++) {
+        assert.equal((await verify('a@test.com', wrong)).status, 401);
+    }
+    const sixth = await verify('a@test.com', wrong);
+    assert.equal(sixth.status, 429);
+
+    const right = await reset({ email: 'a@test.com', otp, newPassword: 'attacker99' });
+    assert.equal(right.status, 400, 'the code was discarded, so a brute-forcer gains nothing by guessing right later');
+    assert.equal(await loginWorks('a@test.com', 'oldpass123'), true);
+});
+
+test('an expired code is refused', async () => {
+    await h.signupAndLogin(api.call, { email: 'a@test.com', password: 'oldpass123' });
+    await request('a@test.com');
+    const otp = h.latestOtpFor('a@test.com');
+    userDoc('a@test.com').otpExpires = new Date(Date.now() - 1000);
+
+    const res = await reset({ email: 'a@test.com', otp, newPassword: 'late12345' });
+    assert.equal(res.status, 401);
+    assert.match(res.body.message, /expired/i);
+    assert.equal(await loginWorks('a@test.com', 'oldpass123'), true);
+});
+
+test("one account's code cannot reset another account", async () => {
+    await h.signupAndLogin(api.call, { email: 'mine@test.com', password: 'mine12345' });
+    await h.signupAndLogin(api.call, { email: 'target@test.com', password: 'target12345' });
+    await request('mine@test.com');
+    await request('target@test.com');
+    const myOtp = h.latestOtpFor('mine@test.com');
+
+    const noCode = await reset({ email: 'victim-without-code@test.com', otp: myOtp, newPassword: 'attacker99' });
+    assert.equal(noCode.status, 404);
+    const res = await reset({ email: 'target@test.com', otp: myOtp, newPassword: 'attacker99' });
+    assert.equal(res.status, 401);
+    assert.equal(await loginWorks('target@test.com', 'target12345'), true);
+
+    // Even if the stored hash were copied over, it is bound to the email it was issued for.
+    userDoc('target@test.com').otpHash = userDoc('mine@test.com').otpHash;
+    const copied = await reset({ email: 'target@test.com', otp: myOtp, newPassword: 'attacker99' });
+    assert.equal(copied.status, 401);
+});
+
+test('new passwords must be long enough, and the code survives a too-short attempt', async () => {
+    await h.signupAndLogin(api.call, { email: 'a@test.com' });
+    await request('a@test.com');
+    const otp = h.latestOtpFor('a@test.com');
+    assert.equal((await reset({ email: 'a@test.com', otp, newPassword: '123' })).status, 400);
+    assert.equal((await reset({ email: 'a@test.com', otp, newPassword: 'longenough1' })).status, 200);
+});
+
+test('if the email cannot be sent, no usable code is left behind', async () => {
+    await h.signupAndLogin(api.call, { email: 'a@test.com' });
+    // The stubbed transport records mail with sentMail.push; make that fail to simulate an SMTP outage.
+    const original = h.sentMail.push;
+    h.sentMail.push = () => { throw new Error('smtp down'); };
+    try {
+        const res = await request('a@test.com');
+        assert.equal(res.status, 500);
+    } finally {
+        h.sentMail.push = original;
+    }
+    assert.equal(userDoc('a@test.com').otpHash, undefined);
+});
diff --git a/backend/utils/pricing.js b/backend/utils/pricing.js
