diff --git a/backend/.env.example b/backend/.env.example
new file mode 100644
index 0000000..03e99d1
--- /dev/null
+++ b/backend/.env.example
@@ -0,0 +1,30 @@
+# Copy to .env and fill in. Never commit the real .env.
+
+PORT=4000
+MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
+
+# Long random string used to sign login tokens and hash reset codes.
+# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
+SECRET=
+
+# Paystack SECRET key (sk_...). Used server-side to confirm payments. Not the public pk_ key.
+PAYSTACK_SECRET_KEY=
+
+# Code someone must enter on the admin signup page. Leave empty to disable admin signup entirely.
+ADMIN_SIGNUP_CODE=
+
+# Gmail account used to send password reset codes (use an app password).
+MAIL=
+PASS=
+
+# Cloudinary (image uploads)
+cloud_name=
+api_key=
+api_secret=
+
+# Optional: extra websites allowed to call the API, comma separated.
+# Defaults to the Vercel site and local dev ports.
+CLIENT_ORIGINS=https://bitemore-chi.vercel.app
+
+# Optional: delivery fee per cart line in naira (default 800).
+DELIVERY_FEE_PER_LINE=800
diff --git a/backend/app.js b/backend/app.js
new file mode 100644
index 0000000..07f60e9
--- /dev/null
+++ b/backend/app.js
@@ -0,0 +1,52 @@
+const express = require('express');
+const helmet = require('helmet');
+const cors = require('cors');
+const router = require('./routers');
+const { apiLimiter } = require('./middleware/rateLimiters');
+
+const app = express();
+
+// The API sits behind Render's proxy; this makes rate limiting see the real client address.
+app.set('trust proxy', 1);
+
+app.use(helmet({ crossOriginResourcePolicy: { policy: 'cross-origin' } }));
+
+// Which websites may call this API from a browser. Add more with CLIENT_ORIGINS (comma separated).
+const defaultOrigins = [
+    'https://bitemore-chi.vercel.app',
+    'http://localhost:5173',
+    'http://localhost:4173',
+    'http://localhost:3000',
+];
+const allowedOrigins = (process.env.CLIENT_ORIGINS
+    ? process.env.CLIENT_ORIGINS.split(',').map((origin) => origin.trim()).filter(Boolean)
+    : defaultOrigins);
+
+app.use(cors({
+    origin(origin, callback) {
+        // No Origin header means curl/server-to-server, not a browser page.
+        if (!origin || allowedOrigins.includes(origin)) return callback(null, true);
+        return callback(null, false);
+    },
+}));
+
+app.use(express.json({ limit: '1mb' }));
+app.use(express.urlencoded({ extended: true, limit: '1mb' }));
+
+// Cheap endpoint for uptime pings (keeps a sleeping free-tier host warm).
+app.get('/health', (req, res) => res.status(200).json({ status: 'ok' }));
+
+app.use('/api/v1', apiLimiter, router);
+
+// Last resort: never send stack traces to the browser.
+// eslint-disable-next-line no-unused-vars
+app.use((err, req, res, next) => {
+    const status = err.status || (err.code === 'LIMIT_FILE_SIZE' ? 400 : 500);
+    const message = err.code === 'LIMIT_FILE_SIZE'
+        ? 'That image is too large (max 5 MB)'
+        : status < 500 ? err.message : 'Internal server error';
+    if (status >= 500) console.error('Unhandled error:', err.message);
+    res.status(status).json({ message, status: false });
+});
+
+module.exports = app;
